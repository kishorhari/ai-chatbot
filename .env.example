# =============================================================================
# AI Platform — example configuration
#
# Copy to `.env` for local development. `.env` is git-ignored and must never be
# committed. Every key the application reads is documented here.
#
# Convention (defined in M1.1 Settings, ADR-0002):
#   - prefix:           AIP__
#   - nested delimiter: __   (e.g. AIP__LLM__DEFAULT_PROVIDER -> llm.default_provider)
# Configuration is read ONLY through the Settings object — never via os.environ
# scattered across the codebase.
# =============================================================================

# --- Application ------------------------------------------------------------
# Runtime environment. Drives logging format and which providers are wired
# (Echo is only available in local/test — see ADR-0004).
# One of: local | test | staging | production
AIP__ENV=local

# --- HTTP server ------------------------------------------------------------
AIP__SERVER__HOST=0.0.0.0
AIP__SERVER__PORT=8000

# --- Logging ----------------------------------------------------------------
# Level: DEBUG | INFO | WARNING | ERROR
AIP__LOGGING__LEVEL=INFO
# Format: console (human-readable, local) | json (structured, non-local)
AIP__LOGGING__FORMAT=console

# --- LLM selection ----------------------------------------------------------
# Selecting a provider is a config change only (ADR-0002), no code edit.
# One of: ollama | echo
AIP__LLM__DEFAULT_PROVIDER=ollama

# --- Ollama adapter ---------------------------------------------------------
AIP__OLLAMA__BASE_URL=http://localhost:11434
AIP__OLLAMA__MODEL=llama3
# Separate connect vs. total request budgets (streaming can run long).
AIP__OLLAMA__CONNECT_TIMEOUT_SECONDS=5.0
AIP__OLLAMA__REQUEST_TIMEOUT_SECONDS=120.0
# Retries apply to the connect phase only; never replay a partially-streamed body.
AIP__OLLAMA__MAX_CONNECT_RETRIES=2
